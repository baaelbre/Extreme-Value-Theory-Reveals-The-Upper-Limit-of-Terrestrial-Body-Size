library(ggplot2)
library(dplyr)
library(GGally)
source('Plotfuncties.R')
sal <- read.csv("Data/salinity.csv", 
                stringsAsFactors = TRUE)

########################################
## Regressie met 1 categorische variabele
########################################

# vereiste dat vissen in 1 aquarium onafhankelijk zijn <-> 'cluster' effect (groeicorrelatie)
# Misschien waterkwaiteit hidden variable
# -> mixed effects model: fixed=saliniteit, random effect=gedeelde variatie in elk aquarium (door gemeensch groeiomstandigheden)

### Opstellen van het lineair model
sal.model <- lm(growth.rate ~ aquaria, data = sal)

### Testen van assumpties
op <- par(mfrow = c(1,3))
plot(sal.model, which = 1:3)
par(op)

car::leveneTest(growth.rate ~ aquaria, data = sal)

summary(sal.model)

# contrasten veranderen
contrasts(sal$aquaria)

# p15 (6 Extra)
levels(sal$aquaria)
levels(sal$aquaria) <- c("Aq 15", "Aq 20", "Aq 25", "Aq 30")

### Beantwoorden van de algemene onderzoeksvraag
anova(sal.model)

