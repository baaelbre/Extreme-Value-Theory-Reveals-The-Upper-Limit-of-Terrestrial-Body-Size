### Energieconsumptie ###

energie <- read.csv("Data/energie1.csv",
                    stringsAsFactors = TRUE)
contrasts(energie$gewicht)

energie.lm <- lm(consumptie ~ gewicht, data=energie)
op <- par(mfrow=c(1,3))
plot(energie.lm, which = 1:3)
# duidelijk probleem i heteroskedasticiteit (normaliteit lijkt op zich ok)
par(op)

# Ga voor klassieke 2 sample test!
# Normaliteit
ggplot(energie, aes(sample = consumptie)) +
  stat_qq() +
  stat_qq_line() +
  facet_wrap(~ gewicht, scales = "free_y")
# Gelijkheid van varianties
ggplot(energie, aes(x=gewicht, y=consumptie)) + geom_boxplot()
var.test(consumptie~gewicht, data=energie)

# of levene...
car::leveneTest(consumptie ~ gewicht, data=energie)

# Welch test
t.test(consumptie ~ gewicht, alternative="less", data=energie, var.equal=FALSE)
# kan ook via kolommen

