s0 <- summary(m0)
s1 <- summary(m1)
s0
s1
rse0 <- s0$sigma
rse1 <- s1$sigma
df0  <- s0$df[2]
df1  <- s1$df[2]
RSS0 <- (rse0^2) * df0
RSS1 <- (rse1^2) * df1
df_add <- df0 - df1
Fobs <- ((RSS0 - RSS1) / df_add) / (RSS1 / df1)
pval <- pf(Fobs, df1 = df_add, df2 = df1, lower.tail = FALSE)
cat(Fobs, df0, df1)
pval
anova(m0, m1)
